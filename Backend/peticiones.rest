# CITA
# @name crear_cita
POST http://localhost:3000/api/citas
content-type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "medico": "{{lista_de_medicos.response.body.datos.[0]._id}}",
    "fecha": "2024-07-01",
    "motivo": "Consulta general"
}

###
# ASIGNAR CITA
PATCH http://localhost:3000/api/citas/asignar
content-type: application/json
Authorization: Bearer {{tokenAdmin}}

{
    "medicoId": "{{lista_de_medicos.response.body.datos.[2]._id}}",
    "pacienteId": "{{lista_de_pacientes.response.body.datos.[2]._id}}"
}

