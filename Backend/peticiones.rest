}

### 2. Crear Usuario Administrador
POST http://localhost:3000/api/auth/registro
Content-Type: application/json

{
  "nombre": "Dra. Maria Admin",
  "email": "admin@email.com",
  "password": "Password123",
  "rol": "admin"
}

### 3. Login como Usuario Normal
# @name loginUsuario
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "juan@email.com",
  "password": "Password123"
}

### Guardar Token del Usuario Normal
@tokenUsuario = {{loginUsuario.response.body.token}}


### 4. Login como Administrador
# @name loginAdmin
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "admin@email.com",
  "password": "Password123"
}

### Guardar Token del Admin
@tokenAdmin = {{loginAdmin.response.body.token}}

